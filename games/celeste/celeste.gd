# Snow particles — 25 white/grey dots blowing left to right with a sine drift,
# matching the original Pico-8 title screen. Each particle stores its position,
# speed, and phase offset in parallel arrays; a Sprite node handles rendering.
const _SNOW_N = 25
var _snow_sprs: Array = []
var _snow_x:   Array = []
var _snow_y:   Array = []
var _snow_spd: Array = []  # pixels/frame in pico-8 space (0.25–5.25)
var _snow_off: Array = []  # sine phase in turns (0–1)
var _snow_col: Array = []  # image id: IMG_SNOW_W or IMG_SNOW_G

var _tile_canvas: Dictionary = {}  # Vector2i → canonical sprite id (0-127), or -1
var _room_x: int = 0
var _room_y: int = 0
var _objects: Array = []
var _deaths: int = 0
var _shake: int = 0
var _freeze: int = 0
var _has_dashed: bool = false
var _prev_keys: Array = []
var _will_restart: bool = false
var _delay_restart: int = 0
var _title: bool = true


func _ready() -> void:
	var img_orig   := "games/celeste/images_original/"
	var img_pair   := "games/celeste/images_pair/"
	var img_single := "games/celeste/images_single/"
	var paths: Array = []
	for i in range(128):
		paths.append(img_orig + "spr%03d.png" % i)   # 0-127   original
	paths.append(Color(0.0, 0.0, 0.0, 0.0))           # 128 IMG_CLEAR
	paths.append(Color(0.05, 0.05, 0.15))              # 129 IMG_BG
	paths.append(Color(1.0, 0.0, 0.302))               # 130 IMG_HAIR_DASH
	paths.append(Color(0.161, 0.678, 1.0))             # 131 IMG_HAIR_NODASH
	paths.append(img_orig + "title.png")               # 132 IMG_TITLE
	paths.append(Color.WHITE)                          # 133 IMG_SNOW_W
	paths.append(Color(0.53, 0.53, 0.53))              # 134 IMG_SNOW_G
	paths.append(Color.BLACK)                          # 135 IMG_BLACK
	for i in range(128):
		paths.append(img_pair + "spr%03d.png" % i)    # 136-263 pair
	for i in range(128):
		paths.append(img_single + "spr%03d.png" % i)  # 264-391 single
	_images = coccoon.ImageList.new(paths)

	for cx in range(coccoon.GRID_W):
		for cy in range(coccoon.GRID_H):
			_tiles[Vector2i(cx, cy)] = coccoon.Sprite.new(IMG_BG, float(cx), float(cy), 0)

	for _i in range(40):
		var spr = coccoon.Sprite.new(IMG_CLEAR, 0.0, 0.0, 1)
		_entity_sprs.append(spr)

	for _i in range(5):
		_hair_sprs.append(coccoon.Sprite.new(IMG_CLEAR, 0.0, 0.0, 2, 0.125))
	_player_spr = coccoon.Sprite.new(IMG_CLEAR, 0.0, 0.0, 3)

	_status_text = coccoon.Text.new(
		"", coccoon.GRID_W, 1, 0, 0, 16, Color.WHITE, Color(0.05, 0.05, 0.15))

	_title_spr  = coccoon.Sprite.new(IMG_CLEAR, float(OX), float(OY), 100, float(L))
	# Credits box: x+c at pico(58,80), matt thorson at (42,96), noel berry at (46,102)
	# → coccoon roughly (10, 3.5)–(24, 7.5); font 14 with blank lines for gap.
	_title_text = coccoon.Text.new(
		"", 28.0, 7.0, 2.0, 0.0, 22, Color(0,0,0,0), Color(0,0,0,0))

	_init_snow()
	_show_title()


func _show_title() -> void:
	_load_room(7, 3)
	for cy in range(coccoon.GRID_H):
		for cx in range(coccoon.GRID_W):
			if _tiles[Vector2i(cx, cy)].image_id == IMG_BG:
				_tiles[Vector2i(cx, cy)].image_id = IMG_BLACK
	_title_text.text = (
		"S: jump   A: dash\n\n" +
		"Original by Maddy Thorson & Noel Berry\n\n" +
		"Quantum remix & coccoon port\nby James Wootton & Daniel Bultrini"
	)
	_title_text.set_font_color(Color(0.55, 0.55, 0.65))
	_title_text.set_background_color(Color(0.0, 0.0, 0.0, 0.0))


func _hide_title() -> void:
	_title_spr.image_id = IMG_CLEAR
	_title_text.set_font_color(Color(0.0, 0.0, 0.0, 0.0))
	_title_text.set_background_color(Color(0.0, 0.0, 0.0, 0.0))
	for s in _snow_sprs:
		s.image_id = IMG_CLEAR
	_title = false
	_load_room(0, 0)


func _init_snow() -> void:
	# Mirror the original: 25 particles with random position, speed, phase, size.
	# Pico-8 screen is 128×128; coccoon grid is 32×18. Scale factor: 32/128 = 0.25.
	for i in range(_SNOW_N):
		var spd := 0.25 + randf() * 5.0          # pico pixels/frame
		var off := randf()                         # sine phase in turns
		var s   := floori(randf() * 5.0 / 4.0)   # 0 or 1, matching flr(rnd(5)/4)
		var col := IMG_SNOW_W if randf() > 0.5 else IMG_SNOW_G
		var sz  := 0.25 if s == 0 else 0.5        # cell size (≈ 1–2 pico pixels scaled)
		_snow_x.append(randf() * 32.0)
		_snow_y.append(randf() * 18.0)
		_snow_spd.append(spd)
		_snow_off.append(off)
		_snow_col.append(col)
		_snow_sprs.append(coccoon.Sprite.new(col, _snow_x[i], _snow_y[i], 101, sz))


func _update_snow() -> void:
	# Pico-8: p.x += p.spd; p.y += sin(p.off); p.off += min(0.05, p.spd/32)
	# sin() in pico-8 uses turns (0–1 = full circle) and is negated vs standard math.
	# We scale x/y movement by 0.25 (128→32 cells). sin() amplitude is also scaled.
	for i in range(_SNOW_N):
		_snow_x[i] += _snow_spd[i] * 0.25
		_snow_y[i] += -sin(_snow_off[i] * TAU) * 0.25  # negated to match pico-8 sin
		_snow_off[i] += min(0.05, _snow_spd[i] / 32.0)
		if _snow_x[i] > 32.0 + 0.1:
			_snow_x[i] = -0.1
			_snow_y[i] = randf() * 18.0
		_snow_sprs[i].x = _snow_x[i]
		_snow_sprs[i].y = _snow_y[i]


# ── Map helpers ───────────────────────────────────────────────────────────────

func _tile_at(tx: int, ty: int) -> int:
	var map_x: int = _room_x * 16 + tx
	var map_y: int = _room_y * 16 + ty
	if map_x < 0 or map_x >= 128 or map_y < 0 or map_y >= 64:
		return 0
	return CELESTE_MAP_FLAT[map_y * 128 + map_x]

func _fget(tile: int, flag: int) -> bool:
	if tile < 0 or tile >= 128:
		return false
	return (CELESTE_GFF[tile] & flag) != 0

func _solid_at(x: float, y: float, w: float, h: float) -> bool:
	var x0: int = floori(x / 8.0)
	var y0: int = floori(y / 8.0)
	var x1: int = floori((x + w - 1.0) / 8.0)
	var y1: int = floori((y + h - 1.0) / 8.0)
	for ty in range(y0, y1 + 1):
		for tx in range(x0, x1 + 1):
			var tile: int = _tile_at(tx, ty)
			if _fget(tile, 1):
				return true
	for obj in _objects:
		var ot: String = obj.get("_type", "")
		var eox: float = obj.get("x", 0.0)
		var eoy: float = obj.get("y", 0.0)
		if ot == "fall_floor" and obj.get("_solid") and not obj.get("_broken"):
			if x + w > eox and x < eox + 8.0 and y + h > eoy and y < eoy + 8.0:
				return true
		if ot == "platform":
			if x + w > eox and x < eox + 16.0 and y + h > eoy and y < eoy + 4.0:
				return true
	return false

func _ice_at(x: float, y: float, w: float, h: float) -> bool:
	var x0: int = floori(x / 8.0)
	var y0: int = floori(y / 8.0)
	var x1: int = floori((x + w - 1.0) / 8.0)
	var y1: int = floori((y + h - 1.0) / 8.0)
	for ty in range(y0, y1 + 1):
		for tx in range(x0, x1 + 1):
			var tile: int = _tile_at(tx, ty)
			if _fget(tile, 16):
				return true
	return false

func _spikes_at(x: float, y: float, w: float, h: float, xspd: float, yspd: float) -> bool:
	var x0: int = floori(x / 8.0)
	var y0: int = floori(y / 8.0)
	var x1: int = floori((x + w - 1.0) / 8.0)
	var y1: int = floori((y + h - 1.0) / 8.0)
	for ty in range(y0, y1 + 1):
		for tx in range(x0, x1 + 1):
			var tile: int = _tile_at(tx, ty)
			if tile == 17:
				if yspd >= 0 and fmod(y + h - 1.0, 8.0) >= 6.0:
					return true
			elif tile == 27:
				if yspd <= 0 and fmod(y, 8.0) <= 2.0:
					return true
			elif tile == 43:
				if xspd <= 0 and fmod(x, 8.0) <= 2.0:
					return true
			elif tile == 59:
				if xspd >= 0 and fmod(x + w - 1.0, 8.0) >= 6.0:
					return true
	return false


# ── Math helpers ──────────────────────────────────────────────────────────────

func _appr(val: float, target: float, amount: float) -> float:
	if val < target:
		return min(val + amount, target)
	return max(val - amount, target)

func _sign(v: float) -> float:
	if v > 0.0: return 1.0
	if v < 0.0: return -1.0
	return 0.0


# ── Player collision helpers ──────────────────────────────────────────────────

func _player_is_solid(p: Dictionary, ox: float, oy: float) -> bool:
	var hx: float = p["x"] + p["hitbox"]["x"] + ox
	var hy: float = p["y"] + p["hitbox"]["y"] + oy
	var hw: float = p["hitbox"]["w"]
	var hh: float = p["hitbox"]["h"]
	if hx < 0.0 or hx + hw > 128.0:
		return true
	return _solid_at(hx, hy, hw, hh)

func _player_is_ice(p: Dictionary, ox: float, oy: float) -> bool:
	return _ice_at(
		p["x"] + p["hitbox"]["x"] + ox,
		p["y"] + p["hitbox"]["y"] + oy,
		p["hitbox"]["w"],
		p["hitbox"]["h"]
	)


# ── Player creation ───────────────────────────────────────────────────────────

func _spawn_player(px8_x: float, px8_y: float) -> void:
	var p: Dictionary = {
		"_type": "player",
		"x": px8_x, "y": px8_y,
		"spd": {"x": 0.0, "y": 0.0},
		"rem": {"x": 0.0, "y": 0.0},
		"hitbox": {"x": 1.0, "y": 3.0, "w": 6.0, "h": 5.0},
		"flip_x": false,
		"grace": 0, "jbuffer": 0,
		"djump": MAX_DJUMP,
		"dash_time": 0, "dash_effect_time": 0,
		"dash_target": {"x": 0.0, "y": 0.0},
		"dash_accel": {"x": 0.0, "y": 0.0},
		"p_jump": false, "p_dash": false,
		"was_on_ground": false,
		"spr_off": 0.0, "spr": 1,
		"hair": [[px8_x + 4.0, px8_y + 3.0], [px8_x + 4.0, px8_y + 3.0],
				 [px8_x + 4.0, px8_y + 3.0], [px8_x + 4.0, px8_y + 3.0],
				 [px8_x + 4.0, px8_y + 3.0]],
	}
	_objects.append(p)


# ── Entity spawning ───────────────────────────────────────────────────────────

func _spawn_spring(px8_x: float, px8_y: float) -> void:
	_objects.append({
		"_type": "spring",
		"x": px8_x, "y": px8_y,
		"timer": 0,
	})

func _spawn_fall_floor(px8_x: float, px8_y: float) -> void:
	_objects.append({
		"_type": "fall_floor",
		"x": px8_x, "y": px8_y,
		"_solid": true, "_broken": false,
		"_state": 0, "_timer": 0,
	})

func _spawn_fruit(px8_x: float, px8_y: float) -> void:
	_objects.append({
		"_type": "fruit",
		"x": px8_x, "y": px8_y,
		"_collected": false,
		"_off": randf() * TAU,
	})

func _spawn_platform(px8_x: float, px8_y: float, dir: int) -> void:
	_objects.append({
		"_type": "platform",
		"x": px8_x, "y": px8_y,
		"_dir": dir,
		"_off": 0.0,
	})


# ── Room management ───────────────────────────────────────────────────────────

func _load_room(rx: int, ry: int) -> void:
	_room_x = rx
	_room_y = ry
	_has_dashed = false
	_objects.clear()
	for tx in range(16):
		for ty in range(16):
			var tile: int = _tile_at(tx, ty)
			match tile:
				1:  _spawn_player(float(tx * 8), float(ty * 8))
				18: _spawn_spring(float(tx * 8), float(ty * 8))
				23: _spawn_fall_floor(float(tx * 8), float(ty * 8))
				26: _spawn_fruit(float(tx * 8), float(ty * 8))
				11: _spawn_platform(float(tx * 8), float(ty * 8), -1)
				12: _spawn_platform(float(tx * 8), float(ty * 8), 1)
	_render()

func _next_room() -> void:
	if _room_x == 7:
		_load_room(0, _room_y + 1)
	else:
		_load_room(_room_x + 1, _room_y)

func _goto_room(rx: int, ry: int, px: float, py: float) -> void:
	_load_room(rx, ry)
	for obj in _objects:
		if obj.get("_type") == "player":
			obj["x"] = px
			obj["y"] = py
			break


# ── Player death ──────────────────────────────────────────────────────────────

func _kill_player() -> void:
	_deaths += 1
	_shake = 10
	_will_restart = true
	_delay_restart = 15
	_player_spr.image_id = IMG_CLEAR


# ── Player movement ───────────────────────────────────────────────────────────

func _player_move_x(p: Dictionary, amount: int) -> void:
	var step: int = int(_sign(float(amount)))
	for _i in range(abs(amount) + 1):
		if not _player_is_solid(p, float(step), 0.0):
			p["x"] += float(step)
		else:
			p["spd"]["x"] = 0.0
			p["rem"]["x"] = 0.0
			break

func _player_move_y(p: Dictionary, amount: int) -> void:
	var step: int = int(_sign(float(amount)))
	for _i in range(abs(amount) + 1):
		if not _player_is_solid(p, 0.0, float(step)):
			p["y"] += float(step)
		else:
			p["spd"]["y"] = 0.0
			p["rem"]["y"] = 0.0
			break

func _player_move(p: Dictionary, ox: float, oy: float) -> void:
	p["rem"]["x"] += ox
	var ax: int = floori(p["rem"]["x"] + 0.5)
	p["rem"]["x"] -= float(ax)
	_player_move_x(p, ax)

	p["rem"]["y"] += oy
	var ay: int = floori(p["rem"]["y"] + 0.5)
	p["rem"]["y"] -= float(ay)
	_player_move_y(p, ay)


# ── Player update ─────────────────────────────────────────────────────────────

func _update_player(p: Dictionary, keys: Array) -> void:
	var input: int = 0
	if K_RIGHT in keys: input = 1
	elif K_LEFT in keys: input = -1

	if _spikes_at(
			p["x"] + p["hitbox"]["x"], p["y"] + p["hitbox"]["y"],
			p["hitbox"]["w"], p["hitbox"]["h"],
			p["spd"]["x"], p["spd"]["y"]):
		_kill_player()
		return

	if p["y"] + p["hitbox"]["y"] + p["hitbox"]["h"] >= 128.0:
		_kill_player()
		return

	var on_ground: bool = _player_is_solid(p, 0.0, 1.0)
	var on_ice: bool = _player_is_ice(p, 0.0, 1.0)

	var jump_btn: bool = K_JUMP in keys or K_JUMP2 in keys
	var jump: bool = jump_btn and not p["p_jump"]
	p["p_jump"] = jump_btn
	if jump:
		p["jbuffer"] = 4
	elif p["jbuffer"] > 0:
		p["jbuffer"] -= 1

	var dash_btn: bool = K_DASH in keys
	var dash: bool = dash_btn and not p["p_dash"]
	p["p_dash"] = dash_btn

	if on_ground:
		p["grace"] = 6
		if p["djump"] < MAX_DJUMP:
			p["djump"] = MAX_DJUMP
	elif p["grace"] > 0:
		p["grace"] -= 1

	p["dash_effect_time"] -= 1

	if p["dash_time"] > 0:
		p["dash_time"] -= 1
		p["spd"]["x"] = _appr(p["spd"]["x"], p["dash_target"]["x"], p["dash_accel"]["x"])
		p["spd"]["y"] = _appr(p["spd"]["y"], p["dash_target"]["y"], p["dash_accel"]["y"])
	else:
		var maxrun: float = 1.0
		var accel: float = 0.6
		var deccel: float = 0.15

		if not on_ground:
			accel = 0.4
		elif on_ice:
			accel = 0.05

		if abs(p["spd"]["x"]) > maxrun:
			p["spd"]["x"] = _appr(p["spd"]["x"], _sign(p["spd"]["x"]) * maxrun, deccel)
		else:
			p["spd"]["x"] = _appr(p["spd"]["x"], float(input) * maxrun, accel)

		if p["spd"]["x"] != 0.0:
			p["flip_x"] = p["spd"]["x"] < 0.0

		var maxfall: float = 2.0
		var gravity: float = 0.21
		if abs(p["spd"]["y"]) <= 0.15:
			gravity *= 0.5
		if input != 0 and _player_is_solid(p, float(input), 0.0) and not _player_is_ice(p, float(input), 0.0):
			maxfall = 0.4
		if not on_ground:
			p["spd"]["y"] = _appr(p["spd"]["y"], maxfall, gravity)

		if p["jbuffer"] > 0:
			if p["grace"] > 0:
				p["jbuffer"] = 0
				p["grace"] = 0
				p["spd"]["y"] = -2.0
			else:
				var wall_dir: int = 0
				if _player_is_solid(p, -3.0, 0.0):
					wall_dir = -1
				elif _player_is_solid(p, 3.0, 0.0):
					wall_dir = 1
				if wall_dir != 0:
					p["jbuffer"] = 0
					p["spd"]["y"] = -2.0
					p["spd"]["x"] = -float(wall_dir) * (maxrun + 1.0)

		var d_full: float = 5.0
		var d_half: float = d_full * 0.70710678118

		if p["djump"] > 0 and dash:
			p["djump"] -= 1
			p["dash_time"] = 4
			p["dash_effect_time"] = 10
			_has_dashed = true

			var v_input: int = 0
			if K_UP in keys: v_input = -1
			elif K_DOWN in keys: v_input = 1

			if input != 0:
				if v_input != 0:
					p["spd"]["x"] = float(input) * d_half
					p["spd"]["y"] = float(v_input) * d_half
				else:
					p["spd"]["x"] = float(input) * d_full
					p["spd"]["y"] = 0.0
			elif v_input != 0:
				p["spd"]["x"] = 0.0
				p["spd"]["y"] = float(v_input) * d_full
			else:
				p["spd"]["x"] = -1.0 if p["flip_x"] else 1.0
				p["spd"]["y"] = 0.0

			_freeze = 2
			_shake = 6
			p["dash_target"]["x"] = 2.0 * _sign(p["spd"]["x"])
			p["dash_target"]["y"] = 2.0 * _sign(p["spd"]["y"])
			p["dash_accel"]["x"] = 1.5
			p["dash_accel"]["y"] = 1.5
			if p["spd"]["y"] < 0.0:
				p["dash_target"]["y"] *= 0.75
			if p["spd"]["y"] != 0.0:
				p["dash_accel"]["x"] *= 0.70710678118
			if p["spd"]["x"] != 0.0:
				p["dash_accel"]["y"] *= 0.70710678118

	# animation
	p["spr_off"] += 0.25
	if not on_ground:
		if _player_is_solid(p, float(input), 0.0):
			p["spr"] = 5
		else:
			p["spr"] = 3
	elif K_DOWN in keys:
		p["spr"] = 6
	elif K_UP in keys:
		p["spr"] = 7
	elif p["spd"]["x"] == 0.0:
		p["spr"] = 1
	else:
		p["spr"] = 1 + int(p["spr_off"]) % 4

	_player_move(p, p["spd"]["x"], p["spd"]["y"])
	_update_hair(p)

	if p["y"] < -4.0 and _room_y * 16 + _room_x < 30:
		_next_room()


func _update_hair(p: Dictionary) -> void:
	var facing: float = -1.0 if p["flip_x"] else 1.0
	var hx: float = p["x"] + 4.0 - facing * 2.0
	var hy: float = p["y"] + 3.0
	var hair: Array = p["hair"]
	# hair[0] is closest to head, hair[4] is the trailing tip
	for i in range(5):
		var tx: float = hx if i == 0 else hair[i - 1][0]
		var ty: float = hy if i == 0 else hair[i - 1][1] - 2.0
		hair[i][0] += (tx - hair[i][0]) / 1.5
		hair[i][1] += (ty - hair[i][1]) / 1.5


# ── Entity updates ────────────────────────────────────────────────────────────

func _update_spring(obj: Dictionary) -> void:
	if obj["timer"] > 0:
		obj["timer"] -= 1
		return
	for o in _objects:
		if o.get("_type") == "player":
			var p: Dictionary = o
			var px: float = p["x"] + p["hitbox"]["x"]
			var py: float = p["y"] + p["hitbox"]["y"]
			var pw: float = p["hitbox"]["w"]
			var ph: float = p["hitbox"]["h"]
			if px + pw > obj["x"] and px < obj["x"] + 8.0 and py + ph > obj["y"] and py < obj["y"] + 8.0:
				if p["spd"]["y"] >= 0.0:
					p["spd"]["y"] = -3.0
					p["djump"] = MAX_DJUMP
					obj["timer"] = 10

func _update_fall_floor(obj: Dictionary) -> void:
	if obj["_state"] == 0:
		for o in _objects:
			if o.get("_type") == "player":
				var p: Dictionary = o
				var px: float = p["x"] + p["hitbox"]["x"]
				var py: float = p["y"] + p["hitbox"]["y"]
				var pw: float = p["hitbox"]["w"]
				var ph: float = p["hitbox"]["h"]
				if px + pw > obj["x"] and px < obj["x"] + 8.0 and py + ph >= obj["y"] and py < obj["y"] + 4.0:
					obj["_state"] = 1
					obj["_timer"] = 15
	elif obj["_state"] == 1:
		obj["_timer"] -= 1
		if obj["_timer"] <= 0:
			obj["_state"] = 2
			obj["_solid"] = false
			obj["_broken"] = true
			obj["_timer"] = 60
	elif obj["_state"] == 2:
		obj["_timer"] -= 1
		if obj["_timer"] <= 0:
			obj["_state"] = 0
			obj["_solid"] = true
			obj["_broken"] = false

func _update_fruit(obj: Dictionary) -> void:
	if obj["_collected"]:
		return
	obj["_off"] += 0.05
	for o in _objects:
		if o.get("_type") == "player":
			var p: Dictionary = o
			var px: float = p["x"] + p["hitbox"]["x"]
			var py: float = p["y"] + p["hitbox"]["y"]
			var pw: float = p["hitbox"]["w"]
			var ph: float = p["hitbox"]["h"]
			if px + pw > obj["x"] and px < obj["x"] + 8.0 and py + ph > obj["y"] and py < obj["y"] + 8.0:
				obj["_collected"] = true
				p["djump"] = MAX_DJUMP

func _update_platform(obj: Dictionary) -> void:
	obj["_off"] += 0.65
	obj["x"] = obj["x"] + float(obj["_dir"]) * 0.65
	if obj["x"] < -16.0:
		obj["x"] = 128.0
	elif obj["x"] > 128.0:
		obj["x"] = -16.0
	for o in _objects:
		if o.get("_type") == "player":
			var p: Dictionary = o
			var px: float = p["x"] + p["hitbox"]["x"]
			var py: float = p["y"] + p["hitbox"]["y"]
			var pw: float = p["hitbox"]["w"]
			var ph: float = p["hitbox"]["h"]
			if px + pw > obj["x"] and px < obj["x"] + 16.0 and py + ph >= obj["y"] and py < obj["y"] + 4.0:
				p["x"] = clampf(p["x"] + float(obj["_dir"]) * 0.65, -1.0, 121.0)


# ── Sprite placement ──────────────────────────────────────────────────────────

func _place_spr(spr, px8_x: float, px8_y: float, img: int, flip_h: bool = false) -> void:
	spr.image_id = img
	spr.x = float(OX) + px8_x / 8.0
	spr.y = float(OY) + float(L - 1) - px8_y / 8.0
	spr.flip_h = flip_h


# ── Render ────────────────────────────────────────────────────────────────────

func _render() -> void:
	for cx in range(coccoon.GRID_W):
		for cy in range(coccoon.GRID_H):
			_tiles[Vector2i(cx, cy)].image_id = IMG_BG

	_tile_canvas.clear()
	for tx in range(16):
		for ty in range(16):
			var tile: int = _tile_at(tx, ty)
			var cx: int = OX + tx
			var cy: int = OY + L - 1 - ty
			var img_id: int
			if tile == 0:
				img_id = IMG_BG
			elif tile >= 128 or tile in [1, 11, 12, 18, 23, 26]:
				img_id = IMG_CLEAR
			else:
				img_id = tile
				_tile_canvas[Vector2i(cx, cy)] = tile
			_tiles[Vector2i(cx, cy)].image_id = img_id

	for spr in _entity_sprs:
		spr.image_id = IMG_CLEAR
	for spr in _hair_sprs:
		spr.image_id = IMG_CLEAR

	var spr_idx: int = 0

	for obj in _objects:
		if spr_idx >= _entity_sprs.size():
			break
		var t: String = obj.get("_type", "")
		match t:
			"player":
				pass
			"spring":
				_place_spr(_entity_sprs[spr_idx], obj["x"], obj["y"], 18)
				spr_idx += 1
			"fall_floor":
				if not obj["_broken"]:
					_place_spr(_entity_sprs[spr_idx], obj["x"], obj["y"], 23)
					spr_idx += 1
			"fruit":
				if not obj["_collected"]:
					var bob_y: float = obj["y"] + sin(obj["_off"]) * 2.0
					_place_spr(_entity_sprs[spr_idx], obj["x"], bob_y, 26)
					spr_idx += 1
			"platform":
				_place_spr(_entity_sprs[spr_idx], obj["x"], obj["y"], 11)
				spr_idx += 1

	var player_drawn: bool = false
	for obj in _objects:
		if obj.get("_type") == "player":
			var hair_img: int = IMG_HAIR_DASH if obj["djump"] > 0 else IMG_HAIR_NODASH
			for i in range(5):
				var hi: int = 4 - i  # draw tip (hi=4, big) first, head (hi=0, small) last
				var sz: float = float(hi + 1) / 8.0  # hi=0→0.125 (head), hi=4→0.625 (tip)
				var seg: Array = obj["hair"][hi]
				_hair_sprs[i].size = sz
				_hair_sprs[i].image_id = hair_img
				_hair_sprs[i].x = OX + seg[0] / 8.0 - sz / 2.0
				_hair_sprs[i].y = OY + float(L - 1) - seg[1] / 8.0 - sz / 2.0
			_place_spr(_player_spr, obj["x"], obj["y"], obj["spr"], obj["flip_x"])
			player_drawn = true
			break
	if not player_drawn:
		_player_spr.image_id = IMG_CLEAR

	_status_text.text = "deaths: " + str(_deaths)


# ── Process ───────────────────────────────────────────────────────────────────

func _flicker_tiles() -> void:
	for pos in _tile_canvas:
		var base: int = _tile_canvas[pos]
		var r: int = randi() % 3
		_tiles[pos].image_id = base + [0, _PAIR_OFFSET, _SINGLE_OFFSET][r]

func _process(_delta: float) -> void:
	_flicker_tiles()
	var inp: Dictionary = coccoon.update()
	var keys: Array = inp["key_presses"]
	var just_pressed: Array = []
	for k in keys:
		if k not in _prev_keys:
			just_pressed.append(k)
	_prev_keys = keys.duplicate()

	if _title:
		_update_snow()
		if K_DASH in just_pressed or K_JUMP2 in just_pressed:
			_hide_title()
		return

	if K_JUMP in just_pressed:
		var nx: int = _room_x + 1
		var ny: int = _room_y
		if nx >= 8:
			nx = 0
			ny = (ny + 1) % 4
		_load_room(nx, ny)
		return

	if _will_restart:
		_delay_restart -= 1
		if _delay_restart <= 0:
			_will_restart = false
			_load_room(_room_x, _room_y)
		return

	if _freeze > 0:
		_freeze -= 1
		return

	if _shake > 0:
		_shake -= 1

	var dead: bool = false
	for obj in _objects:
		if obj.get("_type") == "player":
			_update_player(obj, keys)
			if _will_restart:
				dead = true
				break
	if dead:
		_render()
		return

	for obj in _objects:
		match obj.get("_type", ""):
			"spring":     _update_spring(obj)
			"fall_floor": _update_fall_floor(obj)
			"fruit":      _update_fruit(obj)
			"platform":   _update_platform(obj)

	_render()
